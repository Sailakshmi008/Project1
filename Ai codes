        "#Temporal Models\n",
        "import numpy as np\n",
        "prior = np.array([0.5, 0.5])\n",
        "evidence = np.array([[0.9, 0.2], [0.9, 0.2]])\n",
        "T = np.array([[0.7, 0.3], [0.3, 0.7]])\n",
        "post = prior\n",
        "for i, e in enumerate(evidence):\n",
        "  post = e * (T @ post)\n",
        "  post /= post.sum()\n",
        "  post = post.round(3)\n",
        "  print(f\"P(R{i+1}|U1:{i+1}) = {post}\")\n"
